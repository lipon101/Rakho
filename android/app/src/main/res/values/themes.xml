<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rakho" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/rakho_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Rakho.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rakho_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rakho</item>
    </style>
</resources>
