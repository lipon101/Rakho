# ── Android ──
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml
*.apk
*.aab
# Never commit signing material.
*.jks
*.keystore
android/keystore.properties

# ── Private source: never publish to the public repo ──
# The Android app is deliberately NOT listed here: it is part of the product
# and belongs in the public repo (see the M4 decision). Only the web console
# and its build tooling stay private.
#
# EVERY pattern below is ANCHORED with a leading `/`, i.e. "at the repository
# root only". That anchoring is load-bearing, not cosmetic: an unanchored `src/`
# matches a directory named `src` at ANY depth, and this repository keeps the
# Android app's real source at `android/app/src/` and its tests at
# `android/app/src/test/`. The unanchored rule meant "the web console's src/",
# but git read it as "discard every src/ directory", so a brand-new Kotlin file
# was excluded from git and did not even appear in `git status` --- a silent
# loss, discovered only when somebody cloned the repo and a file was missing.
#
# Anchoring alone fixes it and no `!` negation is needed: `/src/` can only ever
# match the root, so `android/app/src/**` is never affected in the first place.
# See backend/inventory/tests/test_repo_hygiene.py, which fails if any real
# product path becomes ignored --- or if a secret stops being ignored.
/src/
/docs/
/index.html
package.json
package-lock.json
pnpm-workspace.yaml
vite.config.ts
postcss.config.mjs
*.tar.gz

# ...but the backend's operational documentation IS published: a runbook, a
# migration playbook and an onboarding guide that only exist on one laptop are
# not documentation. The `docs/` rule above guards the private web console, so
# the backend's own docs are re-included explicitly.
!backend/docs/
!backend/docs/**

# The load test's seed file holds live branch API keys. A load-test key is
# still a key.
backend/loadtest/seed.json

# Backup dumps and drill reports are produced per environment. The *commands*
# are versioned; the artefacts they write are not --- a database dump in a git
# history is a copy of customer data in a place nobody is guarding.
backend/backups/

# The SBOM is generated by CI for every build and uploaded as an artefact.
backend/sbom/

# Coverage data and rendered reports are build output. The *gate* belongs in CI;
# the .coverage datafile does not belong in git.
backend/.coverage
backend/.coverage.*
backend/htmlcov/
backend/.pytest_cache/
backend/__pycache__/
backend/**/__pycache__/
backend/backups/

# Load-test output. The script and its documentation are versioned; the results
# of one run against a dev server are not, and the timestamped history file
# would otherwise conflict on every concurrent run.
backend/loadtest/results_*.csv
backend/loadtest/__pycache__/

# Firebase config (per-environment, never commit)
google-services.json
**/google-services.json

# Local admin-dashboard preview helpers (never commit)
backend/config/preview_settings.py
backend/seed_preview.py

# Local file storage (exports, uploads). Never committed: contents are the
# product of a test run or a tenant's own data.
media/
backend/media/
# ── Deploy secrets: never commit any of these ──
# The encrypted store. Even though it is encrypted, a ciphertext in a public
# repository is an offline attack target, and there is no reason to hand one out.
backend/.secrets/
.secrets/
*.enc

# The passphrase that unlocks the store. This is the one file whose leak defeats
# the encryption entirely, so it is listed first and matched broadly.
secret.key
*.passphrase
passphrase.txt
.passphrase

# A plaintext copy of the hook, however it got there.
deploy_hook
deploy_hook.txt
deploy_hook.url
deploy-hook*
render_deploy_hook*

# Environment files. `.env.example` is the documented template and IS tracked;
# every real `.env` is not.
.env
.env.*
!.env.example

# ── Tool caches and editor/OS junk ──
# These are regenerated on demand and are never inputs to a build, so a clone
# that carries them is only carrying noise. Listed explicitly (rather than
# relying on a developer's global excludes) so a fresh clone behaves the same
# for everyone.
.mypy_cache/
.ruff_cache/
.pytest_cache/
.gradle/
android/.kotlin/
android/.idea/
.idea/
*.iml
*.hprof
*.orig
*.rej
*.swp
*.swo
*~
# A machine-specific SDK path. Android Studio writes this on first open; it must
# never be committed, because it points at one developer's filesystem.
local.properties
