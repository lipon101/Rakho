# Rakho — environment template
#
# Copy to `.env` for local development (`cp .env.example .env`) and fill in the
# values you need. Nothing here is a real secret; every value is a placeholder
# safe to commit. Rakho reads its configuration from the process environment
# only, so a `.env` file is a convenience for local development, never a
# deployment mechanism.

# ── Which settings module ───────────────────────────────────────────────────
# Leave this unset and the module is chosen for you: `test` runs and a laptop
# get `local`, a Render build gets `production`. Set it explicitly only to
# override that, e.g. to rehearse production behaviour locally:
#   DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local

# ── Core ────────────────────────────────────────────────────────────────────
# 32+ characters. Production refuses to start with the placeholder or a short key.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-chars
DEBUG=true
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ────────────────────────────────────────────────────────────────────
# A wildcard is refused in production; list the console's exact origins instead.
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Admin console ───────────────────────────────────────────────────────────
# The console lives at this path instead of /admin/. Change it in production to
# something unguessable; robots.txt already disallows whatever you choose.
ADMIN_URL=lostsec

# ── Public site ─────────────────────────────────────────────────────────────
# Canonical origin, used by the sitemap, the canonical tag and Open Graph URLs.
SITE_URL=http://localhost:8000
# Which language the human-facing UI opens in when the visitor states no
# preference. Bengali is the product default; `en` gives the English fallback.
SITE_DEFAULT_LANGUAGE=bn

# ── Redis (cache + Celery broker) ───────────────────────────────────────────
# Unset locally: cache falls back to per-process memory and Celery tasks run
# inline, so a contributor needs no Redis to run the suite. Required in
# production, where the DRF throttles must be shared across workers.
REDIS_URL=

# ── Background jobs ─────────────────────────────────────────────────────────
# How often (in minutes) the nightly expiry digest runs. Used by beat schedule.
EXPIRY_DIGEST_MINUTES=1440

# ── Object storage (exports, org logos) ─────────────────────────────────────
# Unset locally: uploads land on the filesystem. In production point these at
# an S3-compatible bucket so a generated report is reachable from every worker.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
EXPORT_URL_TTL_SECONDS=86400

# ── Guards the public /api/v1/setup/* endpoints when set ────────────────────
SETUP_TOKEN=

# ── Manual payments (bKash / Nagad) ─────────────────────────────────────────
PAYMENT_NUMBER=+8801580857515
PAYMENT_METHODS=bKash / Nagad
PRO_PRICE_BDT=299

# ── B2B pricing (M5: base per branch + per-seat add-on) ─────────────────────
# All values are integers in the organisation's currency (BDT by default) so
# invoice arithmetic stays exact.
BRANCH_PRICE_BDT=1499
SEAT_PRICE_BDT=199
INCLUDED_SEATS_PER_BRANCH=3
VAT_PERCENT=15
ORG_TRIAL_DAYS=14

# ── Google Play Billing (server-side verification) ──────────────────────────
# The service-account JSON itself, or a path to the key file. While this is
# empty the billing endpoints answer 503 and every pharmacy stays on the free
# plan --- the app is never trusted to declare itself paid.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.lipon.rakho

# ── The Play listing (optional) ─────────────────────────────────────────────
# Empty until the app is published: the landing page then offers a free API key
# instead of a Play button that would 404.
PLAY_STORE_URL=

# ── Email (org invitations, expiry digests) ─────────────────────────────────
# Unset locally: email is written to the console instead of being sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Rakho <no-reply@rakho.app>

# ── Sentry (errors only; no PII, no performance spans) ──────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# ── Logging ─────────────────────────────────────────────────────────────────
# JSON lines in production, plain text locally.
LOG_LEVEL=INFO

# ── Multi-tenancy (M6) ──────────────────────────────────────────────────────
# Row-Level Security is applied by a migration and only takes effect on
# PostgreSQL. Off by default; turn it on after the migration has been verified
# on staging.
RLS_ENABLED=false
